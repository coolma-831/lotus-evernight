{
  "addons.lotus.descriptions.modules.AutoHelmet": "Swaps to a golden helmet when a piglin is nearby and back to diamond/netherite afterwards.",
  "addons.lotus.descriptions.modules.LightLevel": "Shows block light levels and mob spawn risk areas as a world overlay.",
  "addons.lotus.descriptions.modules.LotusAutoCraft": "Automatically crafts at crafting tables and smithing tables. The table can detect recipes or use a chosen item; the smithing table loops the placed recipe.",
  "addons.lotus.descriptions.modules.LotusAutoEnchant": "Automatically enchants, disenchants and renames items at an enchanting platform. Enchanting needs the given platform; renaming works anywhere. Keep anvils in the hotbar.",
  "addons.lotus.descriptions.modules.LotusAutoKit": "Assembles kits automatically in a Lotus simple warehouse (Baritone required). Sponsored by dadou.",
  "addons.lotus.descriptions.modules.LotusAutoPainting": "Place item frames at two corners, then fills the area with paintings automatically. Takes paintings out of bundles and waits until out-of-reach spots come close.",
  "addons.lotus.descriptions.modules.LotusAutoSign": "Fills and submits sign text automatically when a sign editor opens.",
  "addons.lotus.descriptions.modules.LotusContainerPreview": "Previews shulker box contents, marks opened containers and highlights containers holding the selected item.",
  "addons.lotus.descriptions.modules.LotusEnchantBookFarm": "Finds an unemployed villager, places a lectern and rerolls trades for the selected enchantment books. (Needs a magma block next to the villager and nothing above it.)",
  "addons.lotus.descriptions.modules.LotusEntityList": "Shows nearby players, items and entities grouped by importance, with priority item boxes and pickup alerts.",
  "addons.lotus.descriptions.modules.LotusHelper": "Shared helper settings for the Lotus addon: data folder naming and locked inventory slots.",
  "addons.lotus.descriptions.modules.LotusMapArtCopy": "Copies map art stored in bundles: one bundle to copy, two already-copied bundles and enough empty maps are required.",
  "addons.lotus.descriptions.modules.LotusQuickItemMove": "Shift-drag to move, Alt-click to move or drop same items, R to sort container items.",
  "addons.lotus.descriptions.modules.LotusRaidHelper": "Raid tower helper: drinks ominous bottles on a timer and toggles aura on afterwards.",
  "addons.lotus.descriptions.modules.LotusSpawnerFinder": "Finds spawners a player has already been near, to spot dungeon and mineshaft hideouts.",
  "addons.lotus.descriptions.modules.LotusStorageFilter": "Finds containers that are only ruin decoration, so storage ESP and the stash finder can ignore them.",
  "addons.lotus.descriptions.modules.SpiralFlight": "Scans the map automatically with an Archimedean-spiral, Pitch40 elytra flight.",
